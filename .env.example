# Copy to .env and choose a database password: letters and digits only, since it goes into
# the database URL (for example `openssl rand -hex 16`). The other values have working defaults.
POSTGRES_PASSWORD=
WEB_ORIGIN=http://localhost:3000
# Where browsers reach the API. On the server: the public address followed by /api.
PUBLIC_API_URL=http://localhost:4000
# Proxies in front of the API. On the server behind Caddy: 1.
TRUST_PROXY_HOPS=0
# SMTP server for password reset emails, e.g. smtps://user:password@smtp.tem.scaleway.com:465.
# Left empty, emails are written to the API log.
SMTP_URL=
MAIL_FROM=Blue Court <no-reply@localhost>
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432
